linters: linters_with_defaults(
  defaults           = megaverse::full_linters(),
  object_name_linter = NULL # too many FPs
  )
exclusions: list(
  "R/simulate-long-data.R" = 30,
  "tests/testthat/test-cross-validate-glmm-lasso.R" = list(indentation_linter = Inf),
  "tests/testthat/test-fit-glmm-lasso.R" = list(indentation_linter = Inf),
  "tests/testthat/helper.R",
  "tests/testthat.R"
  )
